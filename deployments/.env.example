# STAIR PLATFORM — Environment Variables
# Copy this file to .env and configure for your environment.

# Database
POSTGRES_USER=stair
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=stair_platform

# API
STAIR_ENVIRONMENT=development
STAIR_DATABASE_URL=postgres://stair:changeme_in_production@localhost:5432/stair_platform?sslmode=disable
STAIR_HTTP_ADDR=:8080
STAIR_REGION=dev
STAIR_INSTANCE_ID=api-1

# Database Pool Tuning
STAIR_DB_MAX_CONNS=10
STAIR_DB_MIN_CONNS=1
STAIR_DB_MAX_CONN_LIFETIME=1h
STAIR_DB_MAX_CONN_IDLE_TIME=30m

# Security
STAIR_SESSION_TTL=24h
STAIR_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
STAIR_HSTS_ENABLED=false

# Redis (optional, for distributed rate limiting)
# Формат: host:port либо redis[s]://[:password@]host:port[/db].
# Пароль/номер БД/TLS: STAIR_REDIS_PASSWORD / STAIR_REDIS_DB / STAIR_REDIS_TLS.
STAIR_REDIS_ADDR=

# Worker (cmd/worker — job queue, EDR-0020/0035)
STAIR_CLEANUP_INTERVAL=1h
STAIR_AUDIT_RETENTION_DAYS=90
STAIR_WORKER_SHUTDOWN_TIMEOUT=10s

# Tracing (optional)
STAIR_TRACING_ENABLED=false
STAIR_TRACING_ENDPOINT=
STAIR_TRACING_SAMPLE_RATE=0.1

# Observability stack (make obs-up): Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_in_production

# Debug (NEVER functional in production — S-111: middleware refuses
# unconditionally regardless of STAIR_DEBUG_LOGGING)
STAIR_DEBUG_LOGGING=false
STAIR_PPROF_ENABLED=false

# Payments (Stripe)
STAIR_STRIPE_SECRET_KEY=
STAIR_STRIPE_WEBHOOK_SECRET=

# Webhook secrets encryption at rest (S1-2). 64 HEX chars = 32 bytes (AES-256).
# Generated via: openssl rand -hex 32
# S-104: MANDATORY in production — api and worker fail-fast on boot without it.
STAIR_SECRETS_KEY=

# Webhook outbound SSRF allowlist (S1-1): comma-separated hosts that may
# resolve to private/loopback ranges. Leave empty for default (block).
STAIR_WEBHOOK_ALLOW_HOSTS=

# SSO / OIDC (optional, for SSO) — Go читает STAIR_SSO_*
STAIR_SSO_ISSUER=
STAIR_SSO_CLIENT_ID=
STAIR_SSO_CLIENT_SECRET=
STAIR_SSO_REDIRECT_URL=
