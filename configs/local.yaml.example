# STAIR PLATFORM — configuration template (DEV-0009)
# Copy to configs/local.yaml and override with local values.
# Secrets (passwords, tokens) must NOT be committed.

http:
  addr: ":8080"

database:
  url: "postgres://stair:changeme@localhost:5432/stair_platform?sslmode=disable"

redis:
  addr: "localhost:6379"

# SSO (EDR-0017): включён только когда задан issuer. Секрет не коммитим.
sso:
  provider: "sso"               # STAIR_SSO_PROVIDER
  issuer: ""                    # STAIR_SSO_ISSUER (пусто → SSO выключен)
  client_id: ""                 # STAIR_SSO_CLIENT_ID
  client_secret: ""             # STAIR_SSO_CLIENT_SECRET
  redirect_url: ""              # STAIR_SSO_REDIRECT_URL