# Переменные фронтенд-сборки (store). Скопируйте в .env для локальной сборки
# или задайте в CI при деплое. Vite подставляет их в бандл на этапе build.
# Без задания используются плейсхолдеры из src/config.ts (P0-7).

# Телефон компании в формате "+7 (900) 123-45-67"
VITE_CONTACT_PHONE=+7 (___) ___-__-__

# Email компании
VITE_CONTACT_EMAIL=info@stair-platform.ru

# Юридический адрес / адрес шоурума
VITE_CONTACT_ADDRESS=Москва, Ленинградский проспект, 36с1