.git
.github
.opencode
docs
frontend/*
!frontend/shared
frontend/shared/*
!frontend/shared/src
!frontend/shared/src/*
# admin-фронт (frontend) собирается в deployments/admin.Dockerfile — вернуть в
# контекст сборки только необходимые файлы. node_modules/dist остаются
# исключёнными (не re-include), тяжёлые артефакты в образ не попадают.
!frontend/package.json
!frontend/index.html
!frontend/vite.config.ts
!frontend/tsconfig.json
!frontend/tsconfig.app.json
!frontend/tsconfig.node.json
!frontend/src
!frontend/public
configs
coverage.out
coverage.html
*.md
# Локальные артефакты никогда не едут в контекст сборки (S-117): свежие
# зависимости ставит `npm ci` внутри образа, dist собирается там же.
**/node_modules
**/dist
