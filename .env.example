# STAIR PLATFORM — Environment Variables
# Copy this file to .env.local and fill in the values.

# Server
STAIR_HTTP_ADDR=:8080
STAIR_GRPC_ADDR=:9090

# Database
STAIR_DATABASE_URL=postgres://stair:stair@localhost:5432/stair_platform?sslmode=disable

# Redis
STAIR_REDIS_URL=redis://localhost:6379

# Storage (EDR-0026)
STAIR_STORAGE_DIR=/tmp/storage

# Rate Limiting (EDR-0014)
STAIR_REGISTER_RATE_LIMIT=100
STAIR_LOGIN_RATE_LIMIT=200

# OIDC (EDR-0015)
STAIR_OIDC_ISSUER_URL=https://accounts.google.com
STAIR_OIDC_CLIENT_ID=
STAIR_OIDC_CLIENT_SECRET=

# Logging
STAIR_LOG_LEVEL=info
STAIR_LOG_FORMAT=json

# CORS
STAIR_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5174

# Frontend URLs
STAIR_STORE_URL=http://localhost:3000
STAIR_ADMIN_URL=http://localhost:5174
