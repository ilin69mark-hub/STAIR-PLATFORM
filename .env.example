# STAIR PLATFORM — Environment Variables
# Copy this file to .env.local and fill in the values.
# Имена переменных согласованы с чтением в Go (cmd/api/main.go, internal/).

# Server
STAIR_ENVIRONMENT=development
STAIR_HTTP_ADDR=:8080
STAIR_GRPC_ADDR=:9090

# Database
# Пароль — для примера (dev); в проде задаётся из секретов, а не коммитится.
STAIR_DATABASE_URL=postgres://stair:changeme@localhost:5432/stair_platform?sslmode=disable

# Redis (optional, for distributed rate limiting) — Go читает STAIR_REDIS_ADDR.
# Формат: host:port либо redis[s]://[:password@]host:port[/db].
# Пароль/номер БД/TLS можно задать отдельно: STAIR_REDIS_PASSWORD / STAIR_REDIS_DB / STAIR_REDIS_TLS.
STAIR_REDIS_ADDR=

# Storage (EDR-0026)
STAIR_STORAGE_DIR=/tmp/storage

# Rate Limiting (EDR-0014)
STAIR_REGISTER_RATE_LIMIT=100
STAIR_LOGIN_RATE_LIMIT=200

# SSO / OIDC (EDR-0015) — Go читает STAIR_SSO_*
STAIR_SSO_ISSUER=
STAIR_SSO_CLIENT_ID=
STAIR_SSO_CLIENT_SECRET=

# Logging
STAIR_LOG_LEVEL=info
STAIR_LOG_FORMAT=json

# Security
# STAIR_COOKIE_SECURE=1 и STAIR_HSTS_ENABLED=1 обязательны в проде (за TLS-edge)
STAIR_COOKIE_SECURE=0
STAIR_HSTS_ENABLED=0

# Webhook secrets encryption at rest (S1-2). 64 HEX chars = 32 bytes (AES-256).
# Generate: openssl rand -hex 32
STAIR_SECRETS_KEY=

# Webhook outbound SSRF allowlist (S1-1): comma-separated hosts allowed to
# resolve to private/loopback ranges. Empty = block (default).
STAIR_WEBHOOK_ALLOW_HOSTS=

# CORS — Go читает STAIR_CORS_ORIGINS (список через запятую)
STAIR_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5177
STAIR_CSRF_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5177

# WebSocket origins (S-112/S-115): список через запятую (exact, "*" или
# "*.domain"). Пусто/не задано = «только same-origin» — безопасный дефолт:
# браузерный WS с того же хоста разрешён, кросс-ориджин отклонён. Если
# STAIR_WS_ORIGINS не задан, но STAIR_CORS_ORIGINS задан явно — используется
# CORS-список (fallback). В same-host проде (nginx: фронт+API на одном хосте)
# можно не задавать вовсе — same-origin достаточно.
STAIR_WS_ORIGINS=

# Frontend URLs
STAIR_STORE_URL=http://localhost:3000
STAIR_ADMIN_URL=http://localhost:5174
STAIR_STORE_ADMIN_URL=http://localhost:5177

# --- Будущие интеграции (реестр docs/SECURITY_EXCEPTIONS.yml) ---
# Ключей ниже НЕТ в коде: якоря для аудита + канонические имена env.
# Прод без заданных значений не запускать (каждая запись — requires_human).
# AUDIT-EXCEPTION(E03): Stars-платежи, см. docs/SECURITY_EXCEPTIONS.yml
#STAIR_STARS_PROVIDER_TOKEN=
# AUDIT-EXCEPTION(E04): WebPush VAPID, см. docs/SECURITY_EXCEPTIONS.yml
#STAIR_VAPID_PUBLIC_KEY=
#STAIR_VAPID_PRIVATE_KEY=
# AUDIT-EXCEPTION(E05): bootstrap admin-token, см. docs/SECURITY_EXCEPTIONS.yml
#STAIR_ADMIN_TOKEN=
# AUDIT-EXCEPTION(E07): allowlist Telegram-ID администраторов, см. docs/SECURITY_EXCEPTIONS.yml
#STAIR_ADMIN_TG_IDS=
